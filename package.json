{
  "name": "what-the-beep",
  "displayName": "What The Beep?!",
  "description": "Play audio alerts",
  "publisher": "groogle",
  "version": "2.7.0",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.138.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leep-frog/what-the-beep"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:what-the-beep.play",
    "onCommand:what-the-beep.playWithArgs"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "what-the-beep.beep",
        "title": "What The Beep?!: Beep"
      },
      {
        "command": "what-the-beep.wrap",
        "title": "What The Beep?!: Wrap"
      }
    ],
    "configuration": {
      "properties": {
        "what-the-beep.terminalActions": {
          "description": "The list of actions to run on terminal events",
          "type": "array",
          "default": [
            {
              "trigger": {
                "commandLineRegex": "# beep\\s*$"
              },
              "command": "what-the-beep.beep",
              "args": {
                "builtin": "success"
              }
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "trigger": {
                "description": "The conditions that will cause the terminal action to execute",
                "type": "object",
                "properties": {
                  "commandLineRegex": {
                    "type": "string",
                    "description": "The regex that, if provided, the terminal command line must match"
                  },
                  "exitCode": {
                    "type": "number",
                    "description": "Exit code of the command. If unset, then all commands will match. If -1, then all non-zero exit codes will match."
                  },
                  "windowFocusBehavior": {
                    "type": "string",
                    "description": "Whether the action runs based on the VS Code window's focus state when the command completes",
                    "default": "always",
                    "enum": [
                      "always",
                      "onlyWhenFocused",
                      "onlyWhenUnfocused"
                    ],
                    "enumDescriptions": [
                      "Run the action regardless of whether the VS Code window is focused",
                      "Only run the action when the VS Code window is focused",
                      "Only run the action when the VS Code window is not focused"
                    ]
                  }
                }
              },
              "command": {
                "description": "The VS Code command to execute (e.g. `what-the-beep.beep`)",
                "default": "what-the-beep.beep",
                "type": "string"
              },
              "args": {
                "description": "The args to pass to the VS Code command",
                "default": {
                  "builtin": "laser"
                },
                "type": "object"
              },
              "desktopNotification": {
                "description": "The desktop notification to display",
                "type": "object",
                "properties": {
                  "title": {
                    "description": "The desktop notification title",
                    "type": "string"
                  },
                  "message": {
                    "description": "The desktop notification message",
                    "type": "string"
                  },
                  "duration": {
                    "description": "How long the desktop notification stays on screen (Windows only). `short` is ~7 seconds and `long` is ~25 seconds.",
                    "type": "string",
                    "enum": [
                      "short",
                      "long"
                    ]
                  }
                }
              },
              "notification": {
                "description": "The VS Code notification to display",
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "The message to display"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ],
                    "description": "The VS Code notification severity"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=bundled-out/extension.js --external:vscode --external:node-notifier --format=cjs --platform=node",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "lint": "eslint src --fix --ext ts",
    "pretest": "npm run compile && npm run esbuild",
    "test-compile": "tsc -p ./",
    "test": "vscode-test --coverage --coverageReporter lcov --coverageReporter html",
    "posttest": "echo 'Open the following file for html coverage report:\nfile:///C:/Users/gleep/Desktop/Coding/vs-code/what-the-beep/coverage/src/index.html'",
    "vscode:prepublish": "npm run test && npm run esbuild-base -- --minify",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "~1.138.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.25.0",
    "eslint": "^8.47.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6"
  },
  "//": "TODO: Change node-notifier from a GitHub commit to a version number once a release including https://github.com/mikaelbr/node-notifier/pull/470 (the `duration` option) is published to npm (11.0.0 does not include it).",
  "dependencies": {
    "@leep-frog/sound-play": "^1.2.5",
    "@leep-frog/vscode-test-stubber": "^2.0.7",
    "node-notifier": "github:mikaelbr/node-notifier#b50f93976b990d7ad63ca5c8810fb751979dbb52"
  }
}
